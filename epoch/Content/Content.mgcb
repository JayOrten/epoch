
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/reference:../pipeline-references/MonoGame.Extended.Content.Pipeline.dll

#---------------------------------- Content ---------------------------------#

#begin ScreenEffect.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:ScreenEffect.fx

#begin UberShader.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:UberShader.fx

#begin config/ascii-tileset.json
/copy:config/ascii-tileset.json

#begin config/atlas-definition.xml
/copy:config/atlas-definition.xml

#begin config/entity-definitions.xml
/copy:config/entity-definitions.xml

#begin config/graphical-tileset.json
/copy:config/graphical-tileset.json

#begin config/tile-definitions.json
/copy:config/tile-definitions.json

#begin config/tilemap-definition.xml
/copy:config/tilemap-definition.xml

#begin images/Anikki_square_20x20.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:images/Anikki_square_20x20.png

